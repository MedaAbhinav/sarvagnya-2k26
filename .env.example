# ── Supabase (public — safe to use in frontend) ──────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Admin Dashboard password ─────────────────────────────────
VITE_ADMIN_PASSWORD=choose_a_strong_password

# ── Email notifications ──────────────────────────────────────
VITE_FORMSUBMIT_EMAIL=organizer@example.com

# ── Supabase Edge Function Secrets (server-side ONLY) ────────
# Set these in: Supabase Dashboard → Edge Functions → Secrets
# NEVER put these in this .env file or commit them.
#
